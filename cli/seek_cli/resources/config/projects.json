    "stability-locate": {
      "description": "应急响应核心应用 - 主链路/逃逸决策/容灾中心/定位任务(POP API)",
      "repoPath": "",
      "a1AppName": "stability-locate",
      "envAliases": {
        "daily": "yanlian"
      },
      "environments": {
        "prod": {
          "platforms": [
            {
              "type": "sls",
              "name": "SLS北京-生产-定位事件日志",
