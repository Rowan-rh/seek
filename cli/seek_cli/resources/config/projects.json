  "projects": {
    "qt-stability": {
      "description": "QT稳定性平台 - 告警富化核心(13+ Processor)，同时是应急链路的告警事件源",
      "repoPath": "",
      "a1AppName": "qt-stability",
      "environments": {
        "prod": {
          "platforms": [
            {
              "type": "sls",
              "name": "SLS杭州-生产-告警事件源",
              "enabled": true,
              "config": {
                "endpoint": "cn-hangzhou.log.aliyuncs.com",
                "project": "qt-stability-cn-hangzhou",
                "logstore": "stability-monitor-event",
                "indexHint": "应急链路上游告警事件源(生产)。日常/演练对应 qt-monitor-cn-beijing/yanlian_qt_stability_event_source，见 daily 环境"
              }
            },
            {
              "type": "sls",
              "name": "SLS上海-生产-应用日志",
              "enabled": true,
              "config": {
                "endpoint": "cn-shanghai.log.aliyuncs.com",
                "project": "qt-monitor-cn-shanghai",
                "logstore": "qt_stability_server_log_prod"
              }
            },
            {
              "type": "sls",
              "name": "SLS上海-生产-标准事件",
              "enabled": true,
              "config": {
                "endpoint": "cn-shanghai.log.aliyuncs.com",
                "project": "qt-monitor-cn-shanghai",
                "logstore": "qt-stability-event"
              }
            },
            {
              "type": "sls",
              "name": "SLS上海-生产-处理过程",
              "enabled": true,
              "config": {
                "endpoint": "cn-shanghai.log.aliyuncs.com",
                "project": "qt-monitor-cn-shanghai",
                "logstore": "qt-stability-event-process"
              }
            }
          ],
          "queryDefaults": {
            "timeRange": "15m",
            "maxResults": 100,
            "sortOrder": "desc"
          }
        },
        "daily": {
          "platforms": [
            {
              "type": "sls",
              "name": "SLS北京-日常/演练-告警事件源",
              "enabled": true,
              "config": {
                "endpoint": "cn-beijing-share.log.aliyuncs.com",
                "project": "qt-monitor-cn-beijing",
                "logstore": "yanlian_qt_stability_event_source",
                "indexHint": "应急链路上游告警事件源(日常/演练)，logstore 名带 yanlian 前缀但承载日常告警。生产对应 qt-stability-cn-hangzhou/stability-monitor-event"
              }
            },
            {
              "type": "sls",
              "name": "SLS上海-日常-标准事件",
              "enabled": true,
              "config": {
                "endpoint": "cn-shanghai.log.aliyuncs.com",
                "project": "qt-monitor-cn-shanghai",
                "logstore": "qt-stability-event-daily"
              }
            },
            {
              "type": "sls",
              "name": "SLS上海-日常-处理过程",
              "enabled": true,
              "config": {
                "endpoint": "cn-shanghai.log.aliyuncs.com",
                "project": "qt-monitor-cn-shanghai",
                "logstore": "qt-stability-event-process-daily"
              }
            }
          ],
          "queryDefaults": {
            "timeRange": "15m",
            "maxResults": 100,
            "sortOrder": "desc"
          }
        },
